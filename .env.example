# Google Gemini API Key (Get free from: https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Twitter / X Developer API v2 Credentials (Get free from: https://developer.x.com)
# Ensure your App has "Read and Write" permissions enabled in User authentication settings!
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Optional: Your X handle to include in the CTA (without the @ symbol)
TWITTER_HANDLE=YourHandle
